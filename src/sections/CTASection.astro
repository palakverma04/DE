---
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CTABox from "../components/ui/CTABox.astro";
---

<Section id="contact" variant="dark" divider={false} class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 linear-glow opacity-30" aria-hidden="true" />
  <div class="relative">
    <SectionHeader
      label="Get started"
      title="See Decision Engines in your environment"
      description="Book a demo tailored to your role — whether you own the close, run AP operations, or evaluate sovereign deployment."
      wide
    />
    <CTABox />
  </div>
</Section>
