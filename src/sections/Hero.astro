---
import Button from "../components/ui/Button.astro";
import HeroBackdrop from "../components/ui/HeroBackdrop.astro";
---

<section class="section-dark relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <HeroBackdrop />

  <div class="site-container relative">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_380px] lg:gap-16">
      <div class="max-w-3xl">
        <p class="section-label hero-item mb-5" style="--i: 0">Agentic Financial Operations Platform</p>

        <h1 class="heading-display text-balance hero-item" style="--i: 1">
          AI that learns your books, runs your close — <span class="text-gradient">and stays yours.</span>
        </h1>

        <p class="body-lg mt-7 max-w-2xl hero-item" style="--i: 2">
          Specialized agents that execute AP, contracts, and reporting end to end — fine-tuning to your organization with every document, and never leaving your perimeter.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-muted-foreground hero-item" style="--i: 3">
          <span class="rounded-full border border-white/10 px-3 py-1">Generative AI</span>
          <span class="rounded-full border border-white/10 px-3 py-1">Private LLMs</span>
          <span class="rounded-full border border-white/10 px-3 py-1">SOC 2 Type II</span>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-3 hero-item" style="--i: 4">
          <Button href="/company/contact" label="Book a Demo" variant="primary" />
          <Button href="#products" label="Explore agents" variant="secondary" />
        </div>
      </div>

      <div class="relative hidden hero-item lg:block" style="--i: 5">
        <div class="pointer-events-none absolute inset-0 rounded-full bg-teal/10 blur-3xl" aria-hidden="true" />
        <img
          src="/images/de-platform-atom.webp"
          alt="Decision Engines platform"
          class="relative mx-auto h-auto w-full max-w-sm"
          width="480"
          height="480"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
