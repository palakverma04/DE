---
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ERPBar from "../components/ui/ERPBar.astro";

const deployments = [
  {
    title: "Self-Hosted",
    points: [
      "Deploy in your VPC, at the edge, or fully on-prem",
      "Models, data, and infrastructure stay inside your perimeter",
      "SOC 2 Type II controls, bare-metal or private VPC",
    ],
    icon: "server",
  },
  {
    title: "Managed",
    points: [
      "Run on Decision-Engines-managed infrastructure",
      "Deployment, scaling, and maintenance handled for you",
      "Fastest path to production",
    ],
    icon: "cloud",
  },
  {
    title: "Hybrid",
    points: [
      "Sensitive workloads stay inside your environment",
      "Managed infrastructure where you need extra scale",
      "Same fine-tuned adapters, either way",
    ],
    icon: "hybrid",
  },
];
---

<Section id="deployment" variant="dark" divider={false} class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 linear-glow opacity-25" aria-hidden="true" />

  <div class="relative">
    <SectionHeader
      label="Deployment"
      title="AI deployment built for privacy"
      description="Financial data cannot wait on policy exceptions. Deploy in your environment, or consume as a service — the architecture doesn't change either way."
      wide
    />

    <div class="grid gap-6 md:grid-cols-3">
      {deployments.map((d, i) => (
        <div class="value-card p-6 md:p-8" data-reveal data-reveal-delay={String(i + 1)}>
          <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-full bg-teal/20 text-teal-light">
            {d.icon === "server" && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/><path d="M8 7h.01M8 17h.01"/></svg>
            )}
            {d.icon === "cloud" && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/><path d="M9 16l2 2 4-4"/></svg>
            )}
            {d.icon === "hybrid" && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            )}
          </div>
          <h3 class="text-lg font-semibold text-white">{d.title}</h3>
          <ul class="mt-4 space-y-2">
            {d.points.map((point) => (
              <li class="flex gap-2 text-sm text-white/65">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-teal" aria-hidden="true" />
                {point}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <ERPBar tone="dark" />
  </div>
</Section>
