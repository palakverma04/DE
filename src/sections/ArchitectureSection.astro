---
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArchitectureDiagram from "../components/diagrams/ArchitectureDiagram.astro";
---

<Section id="architecture" variant="dark" divider={false} class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 linear-glow opacity-25" aria-hidden="true" />

  <div class="relative">
    <SectionHeader
      label="Architecture"
      title="A co-operative team of specialized agents"
      description="Role hierarchy, shared memory, and multi-model orchestration — not a single prompt chain. Your finance team directs; the platform coordinates."
      wide
    />

    <ArchitectureDiagram />

    <p class="body-md mt-8 max-w-3xl text-white/55" data-reveal>
      Every agent reads and writes the same enterprise knowledge graph — context flows from invoice to contract to report without manual handoffs.
    </p>
  </div>
</Section>
