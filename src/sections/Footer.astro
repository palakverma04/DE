---
import { footerSections } from "../data/nav";
import { siteConfig } from "../data/site";
import AISummaryLinks from "../components/ui/AISummaryLinks.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/[0.06] bg-[hsl(216_58%_9%)]">
  <div class="site-container py-16 md:py-20">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a href="/" class="inline-block text-white">
          <img src="/logo-white.png" alt={siteConfig.name} width="167" height="50" class="h-[24px] w-auto opacity-90" />
        </a>
        <p class="body-md mt-4 max-w-sm">
          Agentic financial operations platform — specialized AI agents for AP, contracts, and enterprise finance workflows.
        </p>
        <AISummaryLinks />
        <div class="mt-6 flex items-center gap-4">
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-muted-foreground transition-colors hover:text-foreground" aria-label="LinkedIn">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href={siteConfig.social.x} target="_blank" rel="noopener noreferrer" class="text-muted-foreground transition-colors hover:text-foreground" aria-label="X">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      {footerSections.map((section) => (
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-foreground">{section.title}</h3>
          <ul class="mt-4 space-y-2.5">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-muted-foreground transition-colors hover:text-foreground">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="divider mt-12" />
    <div class="mt-8">
      <p class="text-xs text-muted-foreground">© {year} Decision Engines, Inc.</p>
    </div>
  </div>
</footer>
