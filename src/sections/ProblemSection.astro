---
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CustomerStrip from "./CustomerStrip.astro";

const problems = [
  {
    title: "ERPs are not APIs",
    description:
      "SAP, Oracle, and NetSuite were built for humans clicking screens. Line-item extraction, GL coding, and approval routing require deep schema understanding that most AI stacks lack.",
    icon: "erp",
  },
  {
    title: "Every organization's financial DNA is different",
    description:
      "Charts of accounts, approval hierarchies, and contract language vary wildly. Generic models trained on the internet fail because they have never seen your data.",
    icon: "dna",
  },
  {
    title: "Financial data cannot leave the building",
    description:
      "Invoices, ledgers, and contracts are audited, regulated, and confidential. Public LLM endpoints are often ruled out before the first pilot starts.",
    icon: "lock",
  },
];
---

<Section variant="light" divider={false} class="!pt-10 md:!pt-12">
  <CustomerStrip />

  <SectionHeader
    label="The challenge"
    title="Finance automation breaks where work still needs judgment"
    description="Copilots answer questions. Extraction tools stop at the data. Neither executes a full process inside your ERP — with policies, approvals, and audit trails intact."
    wide
  />

  <div class="grid gap-6 md:grid-cols-3">
    {problems.map((item, i) => (
      <div class="card-light-hover p-6 md:p-8" data-reveal data-reveal-delay={String(i + 1)}>
        <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-full bg-[hsl(var(--light-fg))] text-white">
          {item.icon === "erp" && (
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M6.3 6.3l2.1 2.1m7.2 7.2l2.1 2.1M6.3 17.7l2.1-2.1m7.2-7.2l2.1-2.1"/></svg>
          )}
          {item.icon === "dna" && (
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M12 2v20M8 6c4 0 4 4 8 4s4-4 8-4M8 18c4 0 4-4 8-4s4 4 8 4"/></svg>
          )}
          {item.icon === "lock" && (
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 118 0v4"/></svg>
          )}
        </div>
        <h3 class="heading-card">{item.title}</h3>
        <p class="body-md mt-3">{item.description}</p>
      </div>
    ))}
  </div>
</Section>
