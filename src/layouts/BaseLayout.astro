---
import Navbar from "../sections/Navbar.astro";
import Footer from "../sections/Footer.astro";
import MotionScript from "../components/MotionScript.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
  class?: string;
}

const {
  title = "Decision Engines — Agentic Financial Operations Platform",
  description = "Specialized agents that execute AP, contracts, and reporting end to end — fine-tuning to your organization with every document, and never leaving your perimeter.",
  canonicalUrl,
  ogImage = "/og-image.png",
  ogType = "website",
  publishedTime,
  noindex = false,
  class: className = "",
} = Astro.props;

const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const siteUrl = "https://decisionengines.ai";
const fullCanonical = canonicalUrl ? `${siteUrl}${canonicalUrl}` : siteUrl + Astro.url.pathname;
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:site_name" content="Decision Engines" />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#0B192E" />

    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />
  </head>
  <body class="bg-background font-inter antialiased overflow-x-hidden">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-slate-900">
      Skip to main content
    </a>
    <div class:list={["relative z-10 flex min-h-screen flex-col", className]}>
      <Navbar />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <MotionScript />
  </body>
</html>
