---
import { siteConfig } from "../../data/site";

interface Props {
  providers?: ("chatgpt" | "claude" | "gemini" | "perplexity")[];
}

const { providers = ["chatgpt", "claude", "gemini", "perplexity"] } = Astro.props;

const providerLabels: Record<(typeof providers)[number], string> = {
  chatgpt: "ChatGPT",
  claude: "Claude",
  gemini: "Gemini",
  perplexity: "Perplexity",
};

const providerIcons: Record<(typeof providers)[number], string> = {
  chatgpt: "/icons/ai/chatgpt.svg",
  claude: "/icons/ai/claude.svg",
  gemini: "/icons/ai/gemini.svg",
  perplexity: "/icons/ai/perplexity.svg",
};
---

<div
  class="ai-summary mt-6"
  data-ai-summary
  data-site-name={siteConfig.name}
  data-site-url={siteConfig.url}
  data-providers={providers.join(",")}
>
  <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
    Summarize with AI
  </p>
  <div class="mt-3 flex flex-wrap items-center gap-1.5" role="list">
    {providers.map((id) => (
      <a
        href="#"
        role="listitem"
        data-ai-provider={id}
        class="ai-summary-link group inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition hover:bg-white/[0.06] hover:text-foreground"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Summarize with ${providerLabels[id]}`}
        title={providerLabels[id]}
      >
        <img
          src={providerIcons[id]}
          alt=""
          width="18"
          height="18"
          class="h-[18px] w-[18px] opacity-90 transition group-hover:opacity-100"
          loading="lazy"
        />
      </a>
    ))}
  </div>
</div>

<script>
  import { aiProviders, buildAISummaryPrompt } from "../../utils/aiSummary";

  function initAISummaryLinks() {
    const root = document.querySelector<HTMLElement>("[data-ai-summary]");
    if (!root) return;

    const siteName = root.dataset.siteName || "Decision Engines";
    const siteUrl = root.dataset.siteUrl || window.location.origin;
    const enabledIds = (root.dataset.providers || "").split(",").filter(Boolean);
    const providers = aiProviders.filter((p) => enabledIds.includes(p.id));

    const prompt = buildAISummaryPrompt({
      pagePath: window.location.pathname,
      siteName,
      siteUrl,
    });

    root.querySelectorAll<HTMLAnchorElement>("[data-ai-provider]").forEach((link) => {
      const id = link.dataset.aiProvider;
      const provider = providers.find((p) => p.id === id);
      if (!provider) return;

      link.href = provider.buildUrl(prompt);
    });
  }

  initAISummaryLinks();
  document.addEventListener("astro:page-load", initAISummaryLinks);
</script>
