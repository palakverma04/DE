---
import Button from "./Button.astro";

interface Props {
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  ctaLabel = "Book a demo",
  ctaHref = "/company/contact",
} = Astro.props;

const pillars = [
  {
    title: "8–12 Week Pilot",
    description: "Your data, your hardware, one clear success metric agreed up front.",
    icon: "clock",
  },
  {
    title: "Sovereign by Default",
    description: "Deployed on your infrastructure. Nothing leaves your perimeter.",
    icon: "shield",
  },
  {
    title: "Production Path",
    description: "Pilot architecture is the production architecture — no rebuild.",
    icon: "target",
  },
];
---

<div class="relative overflow-hidden rounded-2xl border border-white/[0.08] bg-[hsl(216_45%_14%)] p-8 md:p-12 lg:p-16" data-reveal>
  <div class="pointer-events-none absolute inset-0 linear-glow opacity-50" aria-hidden="true" />
  <div class="relative">
    <div class="grid gap-4 sm:grid-cols-3">
      {pillars.map((p, i) => (
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] p-5" data-reveal data-reveal-delay={String(i + 1)}>
          <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-full bg-teal/20 text-teal-light">
            {p.icon === "clock" && (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            )}
            {p.icon === "shield" && (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            )}
            {p.icon === "target" && (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            )}
          </div>
          <h3 class="text-sm font-semibold text-white">{p.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-white/60">{p.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-10">
      <Button href={ctaHref} label={ctaLabel} variant="primary" />
    </div>
  </div>
</div>
