---
import { demoRoles, demoProducts, demoCountries, demoProductFromQuery } from "../../data/demoForm";
import { siteConfig } from "../../data/site";

interface Props {
  preselectedProduct?: string;
}

const { preselectedProduct } = Astro.props;
---

<form id="demo-booking-form" class="demo-form card-light p-6 md:p-8" novalidate>
  <p class="text-base font-semibold text-[hsl(var(--light-fg))]">A few quick questions — we'll take it from there.</p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div>
      <label for="demo-name" class="demo-label">Name *</label>
      <input type="text" id="demo-name" name="name" required autocomplete="name" class="demo-input" />
    </div>
    <div>
      <label for="demo-email" class="demo-label">Work email *</label>
      <input type="email" id="demo-email" name="email" required autocomplete="email" class="demo-input" />
    </div>
  </div>

  <fieldset class="mt-6">
    <legend class="demo-label">Your role *</legend>
    <div class="demo-pills mt-3" role="radiogroup" aria-label="Your role">
      {demoRoles.map((role) => (
        <label class="demo-pill">
          <input type="radio" name="role" value={role} required class="sr-only demo-role-input" />
          <span>{role}</span>
        </label>
      ))}
    </div>
    <p id="demo-role-error" class="demo-field-error hidden">Please select your role.</p>
  </fieldset>

  <fieldset class="mt-6">
    <legend class="demo-label">What are you most interested in? *</legend>
    <div class="demo-product-grid mt-3">
      {demoProducts.map((product) => (
        <label
          class="demo-product-card"
          data-product-id={product.id}
          data-preselected={preselectedProduct === product.id ? "true" : undefined}
        >
          <input type="checkbox" name="products" value={product.id} class="sr-only demo-product-input" />
          <span class="demo-product-check" aria-hidden="true">
            <svg class="h-3 w-3 opacity-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
          </span>
          <span class="demo-product-icon" aria-hidden="true">
            {product.icon === "invoice" && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            )}
            {product.icon === "contract" && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
            )}
            {product.icon === "assistant" && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
            )}
            {product.icon === "automation" && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
            )}
          </span>
          <span class="demo-product-title">{product.title}</span>
          <span class="demo-product-desc">{product.description}</span>
        </label>
      ))}
    </div>
    <p id="demo-products-error" class="demo-field-error hidden">Select at least one product.</p>
  </fieldset>

  <div class="mt-6">
    <label for="demo-notes" class="demo-label">Anything specific you'd like to see? <span class="font-normal text-[hsl(var(--light-muted))]">(optional)</span></label>
    <textarea
      id="demo-notes"
      name="notes"
      rows="3"
      placeholder="e.g. three-way matching, multi-entity support, ERP integrations…"
      class="demo-input mt-2 resize-y"
    ></textarea>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div>
      <label for="demo-country" class="demo-label">Country <span class="font-normal text-[hsl(var(--light-muted))]">(optional)</span></label>
      <select id="demo-country" name="country" class="demo-input mt-2">
        <option value="">Select country</option>
        {demoCountries.map((country) => (
          <option value={country}>{country}</option>
        ))}
      </select>
    </div>
    <div>
      <label for="demo-phone" class="demo-label">Phone number <span class="font-normal text-[hsl(var(--light-muted))]">(optional)</span></label>
      <input type="tel" id="demo-phone" name="phone" autocomplete="tel" class="demo-input mt-2" />
    </div>
  </div>

  <button type="submit" class="btn-light mt-8 w-full justify-center py-3 text-base">
    Book My Demo
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </button>

  <p class="mt-4 text-center text-xs leading-relaxed text-[hsl(var(--light-muted))]">
    We won't spam you. By submitting, you agree to our <a href="/privacy" class="text-teal hover:underline">Privacy Policy</a>.
  </p>
</form>

<script define:vars={{ email: siteConfig.email, demoProducts, demoProductFromQuery }}>
  (function () {
    const form = document.getElementById("demo-booking-form");
    if (!form) return;

    const productLabels = Object.fromEntries(demoProducts.map((p) => [p.id, p.title]));

    function setPillSelected(input) {
      const label = input.closest(".demo-pill");
      if (!label) return;
      label.classList.toggle("demo-pill-selected", input.checked);
    }

    function setProductSelected(input) {
      const card = input.closest(".demo-product-card");
      if (!card) return;
      card.classList.toggle("demo-product-selected", input.checked);
      const check = card.querySelector(".demo-product-check svg");
      if (check) check.classList.toggle("opacity-0", !input.checked);
    }

    form.querySelectorAll(".demo-role-input").forEach((input) => {
      input.addEventListener("change", () => setPillSelected(input));
    });

    form.querySelectorAll(".demo-product-input").forEach((input) => {
      input.addEventListener("change", () => {
        setProductSelected(input);
        document.getElementById("demo-products-error")?.classList.add("hidden");
      });
    });

    const params = new URLSearchParams(window.location.search);
    const productParam = params.get("product");
    const mappedProduct = productParam ? demoProductFromQuery[productParam.toLowerCase()] : null;
    if (mappedProduct) {
      const input = form.querySelector('[data-product-id="' + mappedProduct + '"] input');
      if (input) {
        input.checked = true;
        setProductSelected(input);
      }
    }

    form.querySelectorAll('[data-preselected="true"] input').forEach((input) => {
      input.checked = true;
      setProductSelected(input);
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const role = form.querySelector('input[name="role"]:checked');
      const products = form.querySelectorAll('input[name="products"]:checked');
      let valid = true;

      if (!role) {
        document.getElementById("demo-role-error")?.classList.remove("hidden");
        valid = false;
      } else {
        document.getElementById("demo-role-error")?.classList.add("hidden");
      }

      if (products.length === 0) {
        document.getElementById("demo-products-error")?.classList.remove("hidden");
        valid = false;
      } else {
        document.getElementById("demo-products-error")?.classList.add("hidden");
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        valid = false;
      }

      if (!valid) return;

      const name = document.getElementById("demo-name").value.trim();
      const userEmail = document.getElementById("demo-email").value.trim();
      const notes = document.getElementById("demo-notes").value.trim();
      const country = document.getElementById("demo-country").value;
      const phone = document.getElementById("demo-phone").value.trim();

      const productNames = Array.from(products)
        .map((input) => productLabels[input.value] || input.value)
        .join(", ");

      const subject = encodeURIComponent("Demo request — " + productNames);
      const body = encodeURIComponent(
        "Demo Booking Request\n\n" +
          "Name: " + name + "\n" +
          "Email: " + userEmail + "\n" +
          "Role: " + role.value + "\n" +
          "Products: " + productNames + "\n" +
          "Country: " + (country || "—") + "\n" +
          "Phone: " + (phone || "—") + "\n\n" +
          "Specific requests:\n" + (notes || "—")
      );

      window.location.href = "mailto:" + email + "?subject=" + subject + "&body=" + body;
    });
  })();
</script>

<style>
  .demo-label {
    @apply block text-sm font-medium text-[hsl(var(--light-fg))];
  }

  .demo-input {
    @apply w-full rounded-lg border border-[hsl(var(--light-border))] bg-white px-4 py-2.5 text-sm text-[hsl(var(--light-fg))];
  }

  .demo-input:focus {
    @apply border-teal outline-none ring-1 ring-teal;
  }

  .demo-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .demo-pill {
    cursor: pointer;
    border-radius: 9999px;
    border: 1px solid hsl(var(--light-border));
    background: white;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--light-muted));
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .demo-pill:hover {
    border-color: hsl(var(--accent) / 0.4);
  }

  .demo-pill-selected {
    border-color: hsl(var(--accent));
    background: hsl(var(--accent) / 0.08);
    color: hsl(var(--light-fg));
  }

  .demo-product-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .demo-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .demo-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    cursor: pointer;
    border-radius: 0.75rem;
    border: 1px solid hsl(var(--light-border));
    background: white;
    padding: 1rem 1rem 1rem 1.125rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .demo-product-card:hover {
    border-color: hsl(var(--accent) / 0.35);
  }

  .demo-product-selected {
    border-color: hsl(var(--accent));
    box-shadow: 0 0 0 1px hsl(var(--accent) / 0.2);
  }

  .demo-product-check {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    height: 1.125rem;
    width: 1.125rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    border: 1px solid hsl(var(--light-border));
    background: white;
    color: white;
  }

  .demo-product-selected .demo-product-check {
    border-color: hsl(var(--accent));
    background: hsl(var(--accent));
  }

  .demo-product-icon {
    color: hsl(var(--accent));
  }

  .demo-product-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: hsl(var(--light-fg));
    padding-right: 1.5rem;
  }

  .demo-product-desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: hsl(var(--light-muted));
  }

  .demo-field-error {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: hsl(0 72% 50%);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
