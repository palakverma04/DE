---
interface Props {
  value: string;
  label: string;
  class?: string;
}

const { value, label, class: className = "" } = Astro.props;
---

<div class:list={["card-light p-6 md:p-8", className]} data-reveal>
  <p class="stat-value">{value}</p>
  <p class="mt-3 text-sm leading-relaxed text-[hsl(var(--light-muted))]">{label}</p>
</div>
