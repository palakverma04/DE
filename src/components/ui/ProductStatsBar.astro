---
interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

<div class="border-y border-[hsl(var(--light-border))] bg-white py-10 md:py-12" data-reveal>
  <div class="site-container">
    <div class="grid gap-8 md:grid-cols-3 md:gap-0 md:divide-x md:divide-[hsl(var(--light-border))]">
      {stats.map((stat, i) => (
        <div class:list={["px-0 text-center md:px-8", i === 0 && "md:pl-0", i === stats.length - 1 && "md:pr-0"]}>
          <p class="stat-value">{stat.value}</p>
          <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-[hsl(var(--light-muted))]">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</div>
