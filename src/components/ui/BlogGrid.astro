---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<div class="grid gap-5 sm:grid-cols-2">
  {posts.map((post, i) => (
    <a
      href={`/blog/${post.id}`}
      class="card-light-hover block overflow-hidden"
      data-reveal
      data-reveal-delay={String((i % 2) + 1)}
    >
      {post.data.image && (
        <img src={post.data.image} alt="" class="h-44 w-full object-cover" loading="lazy" />
      )}
      <div class="p-6 md:p-8">
        <time datetime={post.data.pubDate.toISOString()} class="text-xs font-medium text-teal">
          {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <h2 class="heading-card mt-2">{post.data.title}</h2>
        <p class="body-md mt-2">{post.data.description}</p>
      </div>
    </a>
  ))}
</div>
