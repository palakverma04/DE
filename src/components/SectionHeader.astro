---
interface Props {
  label?: string;
  title: string;
  description?: string;
  centered?: boolean;
  wide?: boolean;
  class?: string;
}

const { label, title, description, centered = false, wide = false, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "mb-14 md:mb-16",
    wide ? "max-w-3xl" : "max-w-2xl",
    centered && "mx-auto text-center",
    className,
  ]}
  data-reveal
>
  {label && <p class="section-label mb-4">{label}</p>}
  <h2 class="heading-section text-balance">{title}</h2>
  {description && <p class="body-md mt-4">{description}</p>}
</div>
