---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import DemoBookingForm from "../../components/ui/DemoBookingForm.astro";
import { demoExpectations, demoProductFromQuery } from "../../data/demoForm";

const productParam = Astro.url.searchParams.get("product") ?? undefined;
const preselectedProduct = productParam ? demoProductFromQuery[productParam.toLowerCase()] : undefined;
---

<BaseLayout
  title="Book a Demo | Decision Engines"
  description="Book a 30-minute demo tailored to your enterprise workflows — InvoiceIQ, ContractIQ, ConverseIQ, or DecisionIQ."
  canonicalUrl="/company/contact"
>
  <Section variant="light" divider={false} class="!pt-32 md:!pt-40">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:items-start lg:gap-16">
      <div class="max-w-xl" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full border border-teal/25 bg-teal/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-teal">
          <span class="h-1.5 w-1.5 rounded-full bg-teal" aria-hidden="true"></span>
          30-minute demo
        </p>

        <h1 class="heading-display mt-6 text-balance text-[hsl(var(--light-fg))]">
          See Decision Engines in action — tailored to your enterprise workflows
        </h1>

        <p class="body-lg mt-5 text-[hsl(var(--light-muted))]">
          Our experts will walk you through InvoiceIQ, ContractIQ, ConverseIQ, or DecisionIQ using scenarios relevant to your industry and ERP environment.
        </p>

        <div class="mt-10">
          <p class="text-xs font-bold uppercase tracking-widest text-[hsl(var(--light-muted))]">What to expect</p>
          <ul class="mt-4 space-y-3">
            {demoExpectations.map((item) => (
              <li class="flex gap-3 text-sm text-[hsl(var(--light-muted))]">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <img src="/images/soc2.jpg" alt="SOC 2 Type II Compliance" class="h-12 w-auto rounded border border-[hsl(var(--light-border))]" loading="lazy" />
          <img src="/images/sap-store.png" alt="Available on SAP Marketplace" class="h-10 w-auto" loading="lazy" />
        </div>
      </div>

      <div data-reveal data-reveal-delay="2">
        <DemoBookingForm preselectedProduct={preselectedProduct} />
      </div>
    </div>
  </Section>
</BaseLayout>
