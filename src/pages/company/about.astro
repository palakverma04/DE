---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Section from "../../components/Section.astro";
import CTABox from "../../components/ui/CTABox.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CustomerLogoMarquee from "../../components/ui/CustomerLogoMarquee.astro";
import { getScraped } from "../../data/scrapedContent";

const about = getScraped("about")!;
---

<BaseLayout
  title="About | Decision Engines"
  description="Decision Engines — the forefront platform for finance operations powered by AI technology. Globally recognized for autonomous, end-to-end process automation."
  canonicalUrl="/company/about"
>
  <PageHero
    label="Company"
    title="Decision Engines"
    description="The agentic financial operations platform — specialized AI agents that execute AP, contracts, and reporting end to end, fine-tuned to your organization and deployed inside your perimeter."
    variant="light"
    image="/images/de-platform-atom.webp"
    imageAlt="Decision Engines AI platform"
    breadcrumb={[
      { label: "Company", href: "/company/about" },
      { label: "About" },
    ]}
  />

  <Section variant="light" divider={false}>
    <div class="grid gap-10 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="heading-section">Who we are</h2>
        {about.howItWorks.map((para) => (
          <p class="body-md mt-4">{para}</p>
        ))}
        <p class="body-md mt-4">
          Since 2017, Decision Engines has deployed production agents at global enterprises including eBay, McKesson, Nokia, PayPal, and Genentech — with SOC 2 Type II attestation and SAP Store listing.
        </p>
      </div>
      <div class="space-y-4" data-reveal data-reveal-delay="2">
        <div class="card-light p-8">
          <h3 class="heading-card">Platform pillars</h3>
          <ul class="mt-4 space-y-3">
            {["Organization-Specific Fine-Tuning", "Multi-Model Orchestration", "Enterprise Knowledge Graph", "Sovereign Deployment"].map((item) => (
              <li class="flex gap-2 text-sm text-[hsl(var(--light-muted))]">
                <span class="text-teal">→</span> {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="overflow-hidden rounded-xl border border-[hsl(var(--light-border))] bg-white p-4">
          <img src="/images/soc2.jpg" alt="SOC 2 Type II Certified" class="h-auto w-full rounded-lg" loading="lazy" />
        </div>
      </div>
    </div>
  </Section>

  <Section variant="light" divider={false}>
    <CustomerLogoMarquee variant="light" />
  </Section>

  <Section variant="dark" divider={false}>
    <SectionHeader
      label="Get started"
      title="Are you ready to embark on your AI journey?"
      wide
    />
    <CTABox />
  </Section>
</BaseLayout>
