---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import ProblemSection from "../sections/ProblemSection.astro";
import ValuePropSection from "../sections/ValuePropSection.astro";
import ProductsSection from "../sections/ProductsSection.astro";
import ArchitectureSection from "../sections/ArchitectureSection.astro";
import ComparisonSection from "../sections/ComparisonSection.astro";
import ProofSection from "../sections/ProofSection.astro";
import DeploymentSection from "../sections/DeploymentSection.astro";
import CTASection from "../sections/CTASection.astro";

import { siteConfig } from "../data/site";

const siteUrl = siteConfig.url;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Decision Engines",
      url: siteUrl,
      logo: { "@type": "ImageObject", url: `${siteUrl}/logo-white.png` },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Decision Engines",
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: "en-US",
    },
  ],
};
---

<BaseLayout
  title="Decision Engines — Agentic Financial Operations Platform"
  description="Specialized AI agents that execute AP, contracts, and financial workflows end to end — fine-tuned to your organization and deployed inside your perimeter."
  canonicalUrl="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Hero />
  <ProblemSection />
  <ValuePropSection />
  <ProductsSection />
  <ArchitectureSection />
  <ComparisonSection />
  <ProofSection />
  <DeploymentSection />
  <CTASection />
</BaseLayout>
