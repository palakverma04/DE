---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/ui/PageHero.astro";
import Section from "../../../components/Section.astro";
import Button from "../../../components/ui/Button.astro";
import ProcessSteps from "../../../components/ui/ProcessSteps.astro";
import CustomerLogoMarquee from "../../../components/ui/CustomerLogoMarquee.astro";
import {
  internalPages,
  getInternalPage,
  getProcessPages,
  getTeamPages,
  internalPageUrl,
} from "../../../data/internalPages";
import { getSolution } from "../../../data/solutions";
import { getProduct } from "../../../data/products";

export function getStaticPaths() {
  return internalPages.map((page) => ({
    params: { solutionSlug: page.solutionSlug, pageSlug: page.slug },
  }));
}

const { solutionSlug, pageSlug } = Astro.params;
const page = getInternalPage(solutionSlug!, pageSlug!);
const solution = getSolution(solutionSlug!);

if (!page || !solution) {
  return Astro.redirect("/404");
}

const metaTitle = `${page.title} | ${solution.name} | Decision Engines`;
const metaDescription = page.description;

const relatedProcesses = getProcessPages(solutionSlug!).filter((p) => p.slug !== page.slug).slice(0, 3);
const relatedTeams = getTeamPages(solutionSlug!).filter((p) => p.slug !== page.slug).slice(0, 2);
---

<BaseLayout title={metaTitle} description={metaDescription} canonicalUrl={internalPageUrl(page)}>
  <PageHero
    label={`${solution.name} · ${page.type === "process" ? "Process" : "Team"}`}
    title={page.title}
    description={page.description}
    variant="light"
    breadcrumb={[
      { label: "Solutions", href: `/solutions/${solution.slug}` },
      { label: page.title },
    ]}
  />

  <Section variant="light" divider={false}>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-14">
      <div data-reveal>
        <h2 class="heading-section">{page.subtitle}</h2>

        {page.howItWorks.length > 0 ? (
          <div class="mt-8">
            <ProcessSteps steps={page.howItWorks} />
          </div>
        ) : (
          <p class="body-md mt-4">Contact us to learn how Decision Engines agents automate this workflow for your organization.</p>
        )}

        {page.benefits.length > 0 && (
          <>
            <h3 class="heading-card mt-12">Key outcomes</h3>
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {page.benefits.map((benefit) => (
                <li class="card-light flex gap-3 p-4">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                  <span class="text-sm text-[hsl(var(--light-muted))]">{benefit}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start" data-reveal data-reveal-delay="2">
        <div class="card-light p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-teal">Related agents</p>
          <ul class="mt-3 space-y-2">
            {page.relatedProducts.map((slug) => {
              const product = getProduct(slug);
              if (!product) return null;
              return (
                <li>
                  <a href={`/product/${product.slug}`} class="text-sm font-medium text-[hsl(var(--light-fg))] transition-colors hover:text-teal">
                    {product.name} →
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
        <div class="card-light p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-[hsl(var(--light-muted))]">Solution hub</p>
          <a href={`/solutions/${solution.slug}`} class="mt-2 block text-sm font-medium text-teal transition-colors hover:text-teal-light">
            All {solution.name} solutions →
          </a>
        </div>
        <Button href="/company/contact" label="Book a Demo" variant="light" class="w-full justify-center" />
      </aside>
    </div>
  </Section>

  <Section variant="light" divider={false}>
    <CustomerLogoMarquee variant="light" />
  </Section>

  {(relatedProcesses.length > 0 || relatedTeams.length > 0) && (
    <Section variant="light" divider={false}>
      <h2 class="heading-section mb-8" data-reveal>Explore more {solution.name.toLowerCase()} solutions</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[...relatedProcesses, ...relatedTeams].map((related, i) => (
          <a
            href={internalPageUrl(related)}
            class="card-light-hover block p-5"
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-teal">{related.type}</p>
            <h3 class="heading-card mt-1">{related.title}</h3>
            <p class="body-md mt-2 line-clamp-3">{related.description}</p>
          </a>
        ))}
      </div>
    </Section>
  )}

  <Section variant="dark" divider={false}>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <h2 class="heading-section text-white">See {page.title} in production</h2>
        <p class="body-md mt-2 text-white/65">Book a demo with your documents and your success metrics.</p>
      </div>
      <Button href="/company/contact" label="Book a Demo" variant="primary" />
    </div>
  </Section>
</BaseLayout>
