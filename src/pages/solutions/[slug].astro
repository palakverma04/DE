---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/ui/Button.astro";
import CustomerLogoMarquee from "../../components/ui/CustomerLogoMarquee.astro";
import { solutions, getSolution } from "../../data/solutions";
import { getProduct } from "../../data/products";
import {
  getProcessPages,
  getTeamPages,
  internalPageUrl,
} from "../../data/internalPages";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
  }));
}

const { slug } = Astro.params;
const solution = getSolution(slug!);

if (!solution) {
  return Astro.redirect("/404");
}

const processPages = getProcessPages(solution.slug);
const teamPages = getTeamPages(solution.slug);
---

<BaseLayout title={solution.metaTitle} description={solution.metaDescription} canonicalUrl={`/solutions/${solution.slug}`}>
  <PageHero
    label="Solutions"
    title={solution.name}
    description={solution.description}
    variant="light"
    breadcrumb={[
      { label: "Solutions", href: "/solutions/finance" },
      { label: solution.name },
    ]}
  />

  <Section variant="light" divider={false}>
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div data-reveal>
        <h2 class="heading-section">Processes</h2>
        <p class="body-md mt-2 max-w-xl">End-to-end automation workflows powered by specialized agents and your enterprise knowledge graph.</p>
        <ul class="mt-6 space-y-3">
          {processPages.map((process) => (
            <li>
              <a href={internalPageUrl(process)} class="card-light-hover flex items-center gap-3 px-4 py-3.5">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-teal" aria-hidden="true" />
                <span class="text-sm font-medium text-[hsl(var(--light-fg))]">{process.title}</span>
                <svg class="ml-auto h-4 w-4 shrink-0 text-teal opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal data-reveal-delay="2">
        <h2 class="heading-section">Team</h2>
        <p class="body-md mt-2 max-w-xl">Role-specific views and assistants for leaders and operators across the function.</p>
        <ul class="mt-6 space-y-3">
          {teamPages.map((team) => (
            <li>
              <a href={internalPageUrl(team)} class="card-light-hover flex items-center gap-3 px-4 py-3.5">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-orange" aria-hidden="true" />
                <span class="text-sm font-medium text-[hsl(var(--light-fg))]">{team.title}</span>
                <svg class="ml-auto h-4 w-4 shrink-0 text-teal opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section variant="light" divider={false}>
    <CustomerLogoMarquee variant="light" />
  </Section>

  <Section variant="light" divider={false}>
    <h2 class="heading-section mb-8" data-reveal>Related agents</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {solution.relatedProducts.map((productSlug, i) => {
        const product = getProduct(productSlug);
        if (!product) return null;
        return (
          <a href={`/product/${product.slug}`} class="card-light-hover block overflow-hidden" data-reveal data-reveal-delay={String(i + 1)}>
            <img src={product.image} alt={product.name} class="h-32 w-full object-cover object-left-top bg-[hsl(var(--light-card))]" loading="lazy" />
            <div class="p-5">
              <h3 class="heading-card">{product.name}</h3>
              <p class="body-md mt-1">{product.tagline}</p>
            </div>
          </a>
        );
      })}
    </div>
  </Section>

  <Section variant="dark" divider={false}>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <h2 class="heading-section text-white">Explore {solution.name} solutions</h2>
        <p class="body-md mt-2 text-white/65">Built for {solution.team}.</p>
      </div>
      <Button href="/company/contact" label="Book a Demo" variant="primary" />
    </div>
  </Section>
</BaseLayout>
